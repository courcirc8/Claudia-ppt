# Token Replicate — requis pour tous les modèles principaux.
# Récupère le tien sur https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Désactiver l'enrichissement automatique des prompts courts (défaut: true)
# AUTO_ENHANCE_PROMPT=false

# Cache local (défaut: ~/.cache/image-gen)
# IMAGE_GEN_CACHE=/chemin/personnalise
