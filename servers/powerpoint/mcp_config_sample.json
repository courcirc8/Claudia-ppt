{
  "_comment": "Sample Claude Desktop / MCP client config for the PowerPoint server. Replace <ABS_PATH_TO_REPO> with the absolute path where you cloned ClaudIA-ppt.",
  "mcpServers": {
    "ppt": {
      "command": "python3",
      "args": [
        "<ABS_PATH_TO_REPO>/ClaudIA-ppt/servers/powerpoint/ppt_mcp_server.py"
      ],
      "env": {
        "PYTHONPATH": "<ABS_PATH_TO_REPO>/ClaudIA-ppt/servers/powerpoint",
        "PPT_TEMPLATE_PATH": "<ABS_PATH_TO_REPO>/ClaudIA-ppt/servers/powerpoint/templates",
        "PPT_WORKSPACE_ROOT": "<ABS_PATH_TO_REPO>/ClaudIA-ppt/workspace"
      }
    }
  }
}
